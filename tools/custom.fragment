# tools/custom.fragment
# ==============================================================================
# CUSTOM ADVANCED CONFIGS
# Instructions: Uncomment (remove the '# ') to enable a specific configuration.
# ==============================================================================

# --- CORE WIREGUARD ---
CONFIG_WIREGUARD=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y

# --- NETFILTER & IPTABLES UNLOCKERS ---
#CONFIG_NETFILTER_ADVANCED=y
#CONFIG_IP_NF_MANGLE=y
#CONFIG_IP6_NF_MANGLE=y
#CONFIG_NETFILTER_XTABLES=y
#CONFIG_IP_NF_IPTABLES=y
#CONFIG_IP6_NF_IPTABLES=y
#CONFIG_NETFILTER_XT_MATCH_HL=y

# --- TCP BBR / BBRv3 & QUEUING (SPEED & LATENCY) ---
# BBR and the BBRv3 backport live under the TCP_CONG_ADVANCED Kconfig menu.
# The BBRv3 patch adds CONFIG_TCP_CONG_BBR3 and builds tcp_bbr3.o from it.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR3=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Android 12 / kernel 5.10 gives these legacy congestion controls a module
# default once TCP_CONG_ADVANCED is enabled. GKI then rejects modules.order
# because they are not present in android/gki_aarch64_modules. Keep them off;
# BBR/BBRv3 remain built into the kernel above.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set

# --- VIRTUAL NETWORKS ---
CONFIG_DUMMY=y

# --- NOMOUNT VFS ---
# NoMount is a kernel-based file injection and path redirection framework.
# For integration instructions, refer to: https://github.com/maxsteeel/nomount/tree/master/kernel
CONFIG_NOMOUNT=y
