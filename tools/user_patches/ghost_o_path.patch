Close the O_PATH existence oracle for the Android 12 / 5.10 builder.

The upstream guard is retained, but this hunk deliberately anchors only on the
stable beginning of do_o_path(). The A12/5.10 tree is already modified by SUSFS
before user patches are applied, so matching the complete function is needlessly
fragile even though the required insertion point is unchanged.

--- a/fs/namei.c
+++ b/fs/namei.c
@@ -3901,4 +3901,16 @@ static int do_o_path(struct nameidata *nd, unsigned flags, struct file *file)
 {
 	struct path path;
 	int error = path_lookupat(nd, flags, &path);
+	extern bool ghost_hidden_path(const struct path *gp);
+
 	if (!error) {
+		/* O_PATH bypasses ->open and ->permission. */
+		if (ghost_hidden_path(&path)) {
+			path_put(&path);
+			return -ENOENT;
+		}
